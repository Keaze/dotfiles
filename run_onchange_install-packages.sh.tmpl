#!/bin/bash
set -euo pipefail

{{ if eq .chezmoi.osRelease.idLike "arch" -}}
# Bootstrap paru if missing (needed for the AUR section below)
if ! command -v paru &>/dev/null; then
  sudo pacman -S --needed --noconfirm base-devel git
  git clone https://aur.archlinux.org/paru-bin.git /tmp/paru-bin
  (cd /tmp/paru-bin && makepkg -si --noconfirm)
  rm -rf /tmp/paru-bin
fi

# Native packages
sudo pacman -S --needed --noconfirm \
{{ range .packages.pacman }}  {{ . }} \
{{ end }}

# AUR packages
paru -S --needed --noconfirm \
{{ range .packages.aur }}  {{ . }} \
{{ end }}
{{ end -}}

# Rust toolchain via the official rustup installer (https://rustup.rs)
if ! command -v rustup &>/dev/null && [ ! -x "$HOME/.cargo/bin/rustup" ]; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
fi

# Flatpak apps
if command -v flatpak &>/dev/null; then
  sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
  sudo flatpak install -y --noninteractive --or-update flathub \
{{ range .packages.flatpak.flathub }}    {{ . }} \
{{ end }}

  install_github_bundle() {
    local id=$1 repo=$2 url tmp
    flatpak info "$id" &>/dev/null && return 0
    url=$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest" \
      | grep -o '"browser_download_url": *"[^"]*x64\.flatpak"' | cut -d'"' -f4 | head -1)
    tmp=$(mktemp --suffix=.flatpak)
    curl -fsSL -o "$tmp" "$url"
    sudo flatpak install -y --noninteractive "$tmp"
    rm -f "$tmp"
  }
{{ range $id, $repo := .packages.flatpak.github }}  install_github_bundle {{ $id }} {{ $repo }}
{{ end -}}
fi
